# ==============================================================================
# OrangeHRM
# ==============================================================================

OHRM_HOST=localhost
OHRM_HOST_PORT=8080
OHRM_BASE_URL=http://${OHRM_HOST}:${OHRM_HOST_PORT}
OHRM_AUTH_REDIRECT_PORT=9876
OHRM_AUTH_REDIRECT_URL=http://${OHRM_HOST}:${OHRM_AUTH_REDIRECT_PORT}

# ==============================================================================
# MariaDB
# ==============================================================================

# Database credentials
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=orangehrm
MARIADB_USER=orangehrm
MARIADB_PASSWORD=

# Host-machine connection (DBeaver / Playwright)
MARIADB_HOST=localhost
MARIADB_HOST_PORT=3307

# Database client connection
OHRM_DB_HOST=${MARIADB_HOST}
OHRM_DB_PORT=${MARIADB_HOST_PORT}
OHRM_DB_USER=${MARIADB_USER}
OHRM_DB_PASSWORD=${MARIADB_PASSWORD}
OHRM_DB_NAME=${MARIADB_DATABASE}

# ==============================================================================
# Mailpit
# ==============================================================================

MAILPIT_WEB_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025

# Mail configuration
# Sent As:                orangehrm@5.9.test
# Sending Method:         SMTP
# SMTP Host:              mailpit
# SMTP Port:              1025
# SMTP Authentication:    No
# SMTP User:              [blank]
# SMTP Password:          [blank]
# TLS:                    Uncheck
# Send Test Mail          Check
# Test Email Address      orangehrm@5.9.test.example
# Post-registration:
#  - Check the example email in http://localhost:8025

# ==============================================================================
# OAuth — Bruno
# ==============================================================================

# OrangeHRM OAuth client registration
#
# Name:                    Bruno
# Redirect URI:            https://oauth.usebruno.com/callback
# Enable Client:           Yes
# Confidential Client:     Yes
# Grant Type:              Authorization Code
# Use PKCE:                Yes
#
# Authorization URL:
# ${OHRM_BASE_URL}/web/index.php/oauth2/authorize
#
# Access Token URL:
# ${OHRM_BASE_URL}/web/index.php/oauth2/token
#
# Client ID:
# Supply this after registering the Bruno OAuth client in OrangeHRM 5.9
# The env:install script records these values as comments in the local .env.
# BRUNO_OAUTH_CLIENT_ID=
# BRUNO_OAUTH_CLIENT_SECRET=

# OAuth clients created by `npm run env:install`:
SWAGGER_OAUTH_CLIENT_ID=
SWAGGER_OAUTH_CLIENT_SECRET=
PLAYWRIGHT_OAUTH_CLIENT_ID=
PLAYWRIGHT_OAUTH_CLIENT_SECRET=

# ==============================================================================
# OAuth — Playwright
# ==============================================================================

# OrangeHRM OAuth client registration
#
# Name:                    Playwright
# Redirect URI:            http://localhost:9876/oauth/callback
# Enable Client:           Yes
# Confidential Client:     Yes
# Grant Type:              Authorization Code
# Use PKCE:                Yes
#
# Oauth Client ID:
# Supply this after registering the Playwright OAuth client in OrangeHRM 5.9
OHRM_OAUTH_CLIENT_ID=
OHRM_OAUTH_CLIENT_SECRET=
OHRM_OAUTH_AUTH_URL=${OHRM_BASE_URL}/web/index.php/oauth2/authorize
OHRM_OAUTH_TOKEN_URL=${OHRM_BASE_URL}/web/index.php/oauth2/token
OHRM_OAUTH_REDIRECT_URI=${OHRM_AUTH_REDIRECT_URL}/oauth/callback

# ==============================================================================
# OrangeHRM API
# ==============================================================================

API_BASE_URL=${OHRM_BASE_URL}/web/index.php/api/v2

# ==============================================================================
# OrangeHRM — Admin User
# ==============================================================================

# Post-installation setup:
# - Configure Leave Period in the Leave module side panel.
# - Configure Work Week in the Time module side panel.
#
# Use the admin credentials configured during installation.
OHRM_ADMIN_USERNAME=
OHRM_ADMIN_PASSWORD=

# ==============================================================================
# OrangeHRM — ESS User
# ==============================================================================

# Post-installation setup:
# - Add an employee in the PIM module side panel.
# - Use the employee's login credentials for the ESS account below.
#
# Use the credentials configured for the employee created in PIM.
OHRM_ESS_USERNAME=
OHRM_ESS_PASSWORD=
