{
  "name": "orangehrm-5.9",
  "version": "1.0.0",
  "description": "OrangeHRM QA automation framework",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "playwright test",
    "test:live": "playwright test --config=playwright.live.config.js --workers=1",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "token": "node scripts/obtain-token.js",
    "token:admin": "node scripts/obtain-token.js admin",
    "token:ess": "node scripts/obtain-token.js ess",
    "api:smoke": "node scripts/api-smoke.js",
    "db:smoke": "node scripts/db-smoke.js",
    "env:up": "docker compose up -d",
    "env:install": "npm run env:up && node scripts/env-install.js",
    "env:down": "docker compose down",
    "env:reset": "docker compose down -v --rmi local",
    "env:rebuild": "docker compose build --no-cache",
    "env:logs": "docker logs --tail 10 -f orangehrm_5.9_app",
    "env:error": "docker exec -it orangehrm_5.9_app sh -c 'tail -n 10 -f /var/www/html/src/log/orangehrm.log'",
    "openapi:build": "docker exec orangehrm_5.9_app sh -c \"mkdir -p /var/www/html/swagger && /var/www/html/src/vendor/bin/openapi /var/www/html/src/plugins -o /var/www/html/swagger/orangehrm-v2.json && chown -R www-data:www-data /var/www/html/swagger\"",
    "openapi:copy": "docker cp orangehrm_5.9_app:/var/www/html/swagger/orangehrm-v2.json ./swagger/orangehrm-v2.json"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.5",
    "dotenv-expand": "^1000.0.0",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
